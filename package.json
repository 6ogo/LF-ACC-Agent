{
  "name": "acc-agents-global",
  "displayName": "ACC Agents Global Installer",
  "description": "Global installer for ACC Agents for VS Code agent chat.",
  "version": "1.0.0",
  "publisher": "user",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "accAgents.install",
        "title": "Install ACC Agents"
      }
    ]
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/user/LF-ACC-Agent.git"
  }
}
